<div class="container mt-5">
  <div class="card shadow">
    <div class="card-body">
      <h5 class="card-title mb-4">Chat en tiempo real</h5>
      <div class="mb-3">
        <input type="text" id="user" class="form-control" placeholder="Tu nombre" />
      </div>
      <div class="mb-3">
        <input type="text" id="message" class="form-control" placeholder="Escribe un mensaje" />
      </div>
      <div class="mb-3">
        <button id="send-btn" class="btn btn-primary w-100">Enviar</button>
      </div>
      <ul id="chat-messages" class="list-group"></ul>
    </div>
  </div>
</div>
